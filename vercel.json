{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "devCommand": "pnpm run build && pnpm run start"
    },
    "kickshift-storefront": {
      "root": "artifacts/kickshift-storefront",
      "framework": "vite",
      "buildCommand": "node ../../scripts/run-vite.mjs build 25941 /",
      "devCommand": "node ../../scripts/run-vite.mjs dev 25941 /",
      "outputDirectory": "dist/public",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "buildCommand": "node ../../scripts/run-vite.mjs build 8081 /__mockup/",
      "devCommand": "node ../../scripts/run-vite.mjs dev 8081 /__mockup/",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/__mockup",
      "destination": {
        "service": "mockup-sandbox"
      }
    },
    {
      "source": "/__mockup/(.*)",
      "destination": {
        "service": "mockup-sandbox"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "kickshift-storefront"
      }
    }
  ]
}
